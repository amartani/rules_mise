# Generated by mise
"""Toolchain plumbing for tools in the mise hub.

`toolchain_info` carries one platform's resolved tool executable as a
ToolchainInfo provider; `declare_toolchain()` declares the toolchain for a
target platform, wired to the matching per-platform tool repo.
Users register the generated toolchains via
`register_toolchains("@<hub>//toolchains:all")`.
"""

def _toolchain_info_impl(ctx):
    return [
        platform_common.ToolchainInfo(
            executable = ctx.file.executable,
            cpu = ctx.attr.cpu,
            os = ctx.attr.os,
            ext = ctx.attr.ext,
            files = ctx.files.files,
        ),
    ]

toolchain_info = rule(
    doc = "Carries a resolved tool executable for one os/cpu pair.",
    attrs = dict(
        executable = attr.label(allow_single_file = True),
        cpu = attr.string(mandatory = True, values = ["arm64", "x86_64"]),
        os = attr.string(mandatory = True, values = ["linux", "macos", "windows"]),
        ext = attr.string(mandatory = True, values = ["", ".exe"]),
        files = attr.label_list(allow_files = True),
    ),
    implementation = _toolchain_info_impl,
)

def _extension(os):
    if os == "windows":
        return ".exe"
    return ""

def declare_toolchain(name, os, cpu, toolchain_type, hub_name):
    """Declares the toolchain_info target and toolchain for a target platform.

    Generated code: called for every locked (tool, os, cpu) binary. The
    generated toolchains resolve the executable from the per-platform tool
    repo `@@<hub_name>.<name>.<os>_<cpu>`, so registering the hub's
    `toolchains:all` makes toolchain machinery pick the right binary per
    platform.

    Args:
        name: Sanitized mise tool name (the `tools/<name>` package).
        os: Toolchain OS (`linux`, `macos`, or `windows`).
        cpu: Toolchain CPU (`arm64` or `x86_64`).
        toolchain_type: The tool's `toolchain_type` target.
        hub_name: The hub repository name (used to construct repo keys).
    """
    ext = _extension(os)
    toolchain_info(
        name = "{name}_{os}_{cpu}_toolchain_info".format(name = name, os = os, cpu = cpu),
        executable = "@@{hub_name}.{name}.{os}_{cpu}//tools/{name}:{os}_{cpu}_executable{ext}".format(name = name, os = os, cpu = cpu, hub_name = hub_name, ext = ext),
        os = os,
        cpu = cpu,
        ext = ext,
        files = ["@@{hub_name}.{name}.{os}_{cpu}//tools/{name}:conda_files".format(name = name, os = os, cpu = cpu, hub_name = hub_name)],
    )

    # Only a target-constrained toolchain: an exec-constrained one would also
    # match a cross build (e.g. a Windows test built on Linux) and hand it the
    # execution platform's binary. A tool used in the exec configuration is
    # built for the execution platform, so this toolchain still matches there.
    native.toolchain(
        name = "{name}_{os}_{cpu}_toolchain".format(name = name, os = os, cpu = cpu),
        toolchain = ":{name}_{os}_{cpu}_toolchain_info".format(name = name, os = os, cpu = cpu),
        toolchain_type = toolchain_type,
        target_compatible_with = [
            "@platforms//cpu:{cpu}".format(cpu = cpu),
            "@platforms//os:{os}".format(os = os),
        ],
    )
