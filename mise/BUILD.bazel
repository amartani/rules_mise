bzl_library(
    name = "cwd",
    srcs = ["cwd.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//mise/private:cwd"],
)

bzl_library(
    name = "workspace_root",
    srcs = ["workspace_root.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//mise/private:workspace_root"],
