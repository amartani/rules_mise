load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":hub",
        "//mise/private:lockfile",
        "@toml.bzl//toml:toml",
    ],
)

bzl_library(
    name = "hub",
    srcs = ["hub.bzl"],
