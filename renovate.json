{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "timezone": "Etc/UTC",
  "minimumReleaseAge": "14 days",
  "updateNotScheduled": false,
  "automerge": true,
  "packageRules": [
    {
      "matchFileNames": ["MODULE.bazel"],
      "enabled": false
    },
    {
      "matchManagers": ["mise"],
      "lockFileMaintenance": { "enabled": true }
    },
    {
      "description": "Group routine dependency updates into one weekly PR",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "schedule": ["* 0-23 * * 5"]
    }
  ]
}
